# TRACE backend — PRODUCTION env for the OCI host.
# Copy to `.env` next to docker-compose.yml, fill values, then: docker compose up -d --build
# (docker compose auto-loads `.env`; never commit the filled-in file.)

# Postgres password — make it long & random.
POSTGRES_PASSWORD=change-me-long-random

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# CORS: "*" is fine for the native iOS app (no browser origin).
CORS_ORIGINS=*

# Photo storage: "local" (named volume) for the first deploy; "oci" (Object Storage) later.
STORAGE_BACKEND=local

# Public base URL the app + photo refs resolve against.
# First deploy without a domain/TLS: http://<your-public-ip>:8000
PUBLIC_BASE_URL=http://CHANGE-ME-PUBLIC-IP:8000

# Social login verification — MUST match the iOS client ids.
APPLE_CLIENT_ID=com.efreedom.trace
KAKAO_REST_API_KEY=
GOOGLE_CLIENT_ID=

# Abuse throttle (requests/min per client IP per path; 0 = off).
RATE_LIMIT_PER_MINUTE=120
