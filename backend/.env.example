# Copy to .env for local dev (git-ignored). Production values are set on the OCI host.

# ── Core ──────────────────────────────────────────────────────────────────────
# Local dev default is SQLite (no infra). For Postgres:
#   postgresql+asyncpg://trace:trace@localhost:5432/trace
DATABASE_URL=sqlite+aiosqlite:///./trace.db
JWT_SECRET=dev-insecure-change-me-please
CORS_ORIGINS=*

# ── Auth providers (optional for PoC) ─────────────────────────────────────────
# Apple "aud" — your app bundle id (com.efreedom.trace) or Services ID.
APPLE_CLIENT_ID=com.efreedom.trace
# Kakao REST API key (for verifying Kakao access tokens via /v2/user/me).
KAKAO_REST_API_KEY=

# ── Photo storage ─────────────────────────────────────────────────────────────
# "local" = save to LOCAL_STORAGE_DIR and serve via /photos/{ref}; "oci" = Object Storage.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./_photos
PUBLIC_BASE_URL=http://localhost:8000

# ── OCI Object Storage (when STORAGE_BACKEND=oci) ─────────────────────────────
OCI_NAMESPACE=
OCI_BUCKET=moment-photos
OCI_REGION=
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
