// Sensitive.xcconfig.example — COMMITTED TEMPLATE
//
// The real file (XCConfigs/Sensitive.xcconfig) is git-ignored and lives only on your machine.
// Other xcconfigs reference it by relative path, so the real file MUST exist before
// `tuist generate`. Create it from this template:
//
//   cp XCConfigs/Sensitive.xcconfig.example XCConfigs/Sensitive.xcconfig
//
// Then fill in local-only values below. NEVER commit real secrets.

// DEVELOPMENT_TEAM =

// ── TRACE backend API ──
// Leave TRACE_API_HOST blank to run on the in-memory mock store.
// ⚠️ xcconfig treats "//" as a comment, so put the HOST ONLY (no scheme).
//    The app builds the URL as $(TRACE_API_SCHEME)://$(TRACE_API_HOST); scheme defaults
//    to https (set in Trace.xcconfig). For a plain-HTTP local/IP test, also set
//    TRACE_API_SCHEME = http here.
// TRACE_API_HOST = api.yourdomain.com
// TRACE_API_SCHEME = https

// ── Social login (app-embedded client identifiers; kept out of git) ──
// Kakao Native App Key (카카오 developers → 내 앱 → 앱 키 → 네이티브 앱 키).
KAKAO_NATIVE_APP_KEY =
// Google iOS OAuth client id — e.g. 1234-abc.apps.googleusercontent.com
GOOGLE_CLIENT_ID =
// Reversed form for the URL scheme — e.g. com.googleusercontent.apps.1234-abc
GOOGLE_REVERSED_CLIENT_ID =
